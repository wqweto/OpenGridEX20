{
    "$schema": "opengex-visualdiff/1",
    "name": "formatstyles-selection",
    "width": 400,
    "height": 260,
    "apply": "before-show",
    "props": {
        "RowHeaders": true,
        "FormatStyles": [
            { "Name": "SelectedRow", "BackColor": 0x004080, "ForeColor": 0x80FFFF }
        ],
