{
    "$schema": "opengex-visualdiff/1",
    "name": "newrow-grouped",
    "width": 400,
    "height": 250,
    "apply": "before-show",
    "props": {
        "GroupByBoxVisible": false,
        "AllowAddNew": true,
        "AllowEdit": true,
        "NewRowPos": 1,
        "Columns": [
            { "Caption": "Alpha", "Width": 1500, "EditType": 1 },
            { "Caption": "Beta", "Width": 1500, "EditType": 1 }
        ]
    },
    "unbound": {
        "rows": [
            [ "north", "n1" ],
            [ "north", "n2" ],
            [ "south", "s1" ]
        ]
    },
    "post": { "Groups": [ { "ColIndex": 1, "SortOrder": 1 } ] }
}
