{
    "$schema": "opengex-visualdiff/1",
    "name": "unfocused-normal",
    "width": 400,
    "height": 200,
    "apply": "before-show",
    "props": {
        "GroupByBoxVisible": false,
        "AllowEdit": false,
        "HideSelection": 2,
        "Columns": [
            { "Caption": "Alpha", "Width": 1500, "EditType": 1 },
            { "Caption": "Beta", "Width": 1500, "EditType": 1 }
        ]
    },
    "unbound": {
        "rows": [
            [ "a1", "b1" ],
            [ "a2", "b2" ]
        ]
    },
    "input": [
        { "focus": true },
        { "click": [ 600, 480 ] },
        { "unfocus": true }
    ]
}
