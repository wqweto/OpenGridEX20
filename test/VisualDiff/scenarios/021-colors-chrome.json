{
    "$schema": "opengex-visualdiff/1",
    "name": "colors-chrome",
    "width": 400,
    "height": 260,
    "apply": "before-show",
    "props": {
        "GroupByBoxVisible": true,
        "RowHeaders": true,
        "BackColorHeader": 0x8000FF,
        "ForeColorHeader": 0x00FFFF,
        "BackColorGBBox": 0x604020,
        "BackColorInfoText": 0x30A0C0,
        "ForeColorInfoText": 0x0020FF,
        "GroupByBoxInfoText": "Group by box info text",
        "Columns": [
            { "Caption": "Alpha", "Width": 1200 },
            { "Caption": "Beta", "Width": 1200 }
        ]
    },
    "unbound": {
        "rows": [
            [ "one", "1" ],
            [ "two", "2" ],
            [ "three", "3" ]
        ]
    }
}
